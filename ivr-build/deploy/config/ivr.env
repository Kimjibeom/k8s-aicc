# aicc-ivr 환경 설정 (configmap/aicc-<GROUP>-ivr-config 생성용 — ivr·nodered 두 컨테이너가 envFrom 으로 공유)
# 비밀값(IVR_DB_PASSWORD, NODERED_*)은 20-secret.yaml 에만 둔다. 기본값은 TUI(view_dialog_install.sh)·설치 매뉴얼 기준.

# ── IP / IVR ID (TUI: IP setting / IVR CALL SERVER ID) ─────────────────────────────
# 미지정 시 파드 IP(hostNetwork 면 노드 IP) 자동 사용
#IVR_IP=
IVR_ID=1                             # IVR 서버 다중화 시 2,3.. (매뉴얼: IVR_ID≥2 는 채널을 DB 에서 직접 설정)
IVR_RESOLVE_HOSTS=1                  # DB/CTI 호스트명을 기동 시 IP 로 변환해 기록 (TUI 는 IP 만 허용)

# ── Database (TUI: DATABASE setting) ──────────────────────────────────────────────
IVR_DB_HOST=aicc-db                  #[환경전환] db-build Service 또는 외부 DB IP (deploy.env 연동)
IVR_DB_PORT=3316
IVR_DB_NAME=uivr                     # v2.0부터 jedai_ivr → uivr
IVR_DB_USER=nexus
IVR_DB_INIT=on                       # on: CREATE DATABASE IF NOT EXISTS + 1-/2-IVR_DATABASE_SCRIPT.SQL (멱등, 매 기동)
#CTI_DB_HOST=                        # Node-RED CONFIG 탭 JEDAI_CUBE 노드 (비우면 IVR_DB_HOST/PORT/USER/PASSWORD)

# ── SIP (TUI: SIP setting) ────────────────────────────────────────────────────────
IVR_SIP_REALM=nexuscommunity.net
IVR_SIP_REMOTE_IP=                   #[환경전환] U PBX SIP IP (필수)
IVR_SIP_REMOTE_PORT=5060
IVR_SIP_LOCAL_PORT=9060              # 매뉴얼 실측값 — hostNetwork 에서 PBX 5060 과 충돌 방지
IVR_SIP_TRANSPORT=UDP                # UDP | TCP
IVR_RTP_START_PORT=36384             # PBX 동거 시 U PBX RTP(16384~) 와 충돌 확인 (매뉴얼)
IVR_MAX_CALL=30                      # 30~300
#IVR_RTP_END_PORT=                   # 비우면 start + max_call*2 + 4 (설치 스크립트 공식). 매뉴얼 권장은 채널 대비 120%
IVR_MEDIA_PORT=1900
IVR_EXPIRES=300

# ── CTI CUBE (TUI: CTI CUBE setting) ──────────────────────────────────────────────
IVR_CTI_USE=on
IVR_CTI_HOST1=aicc-cti               #[환경전환] cti-build Service(aicc-cti) 또는 CTI 서버 IP
#IVR_CTI_HOST2=                      # Standby (단중화면 비움 → ip2='', use_ha=0)
IVR_CTI_PORT=9714                    # CTI nxlistener 1214 (sys_uivr)
IVR_CTI_SID=1                        # PBX SERVER ID
IVR_CTI_APPNAME=sys_uivr

# ── 등록 / 채널 ──────────────────────────────────────────────────────────────────
IVR_REGISTER=on                      # t_ivr_config/t_ivr_cti 를 env 기준 upsert (env 관리 컬럼만)
IVR_CHANNEL_SEED=auto                # auto: 이 IVR_ID 채널 0건일 때만 / always / off

# ── Node-RED ─────────────────────────────────────────────────────────────────────
NODERED_PORT=1890                    # 편집기 + 시나리오 HTTP (t_ivr_scenario_server.port)
NODERED_FLOWS_MODE=seed              # seed: PVC 에 flows 없을 때만 / configmap: 매 기동 flows.d 로 덮어씀(무상태)
