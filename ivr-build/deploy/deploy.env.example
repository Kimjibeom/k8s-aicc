# ── AICC IVR 통합 배포 환경 설정 (deploy.env.example) ──
# 대상 환경에 맞춰 복사(cp deploy.env.example deploy.env) 후 사용합니다. 특정 테스트 환경 IP/노드명은 넣지 않습니다.

# 1. 기본 쿠버네티스 설정
NS=aicc                               # 대상 네임스페이스
GROUP=shr                             # 공용풀(shr) 또는 전용풀(ded1, ded2...)
SITE=a                                # 사이트 식별자 (a=1번 서버, b=2번 서버) — SITE b 는 config/ivr.env 의 IVR_ID=2 와 짝

# 2. 연동 대상 (ConfigMap 에 주입, 비우면 config/ivr.env 값 유지)
IVR_DB_HOST=aicc-db                   # db-build Service 또는 외부 DB IP
IVR_DB_PORT=3316
IVR_SIP_REMOTE_IP=                    # U PBX SIP IP (필수)
IVR_CTI_HOST1=aicc-cti                # cti-build Service 또는 CTI IP

# 3. 노드 고정 및 네트워크
TARGET_NODE_NAME=                     # IVR IP(=노드 IP)를 고정할 노드명 (미지정 시 nodeSelector 주석 처리)
ENABLE_HOST_NETWORK=true              # SIP/RTP 직접 통신 (false 는 PBX 가 같은 클러스터 파드 네트워크일 때만 의미)

# 4. 이미지 및 레지스트리
IVR_IMAGE=jibeom/aicc:ivr-2.0.2.108-1
NODERED_IMAGE=jibeom/aicc:ivr-nodered-2.0.2.108-1    # MP3 업로드 필요 시 ...-1-ffmpeg (WITH_FFMPEG=1 빌드)
IMAGE_PULL_SECRET=regcred             # 폐쇄망 로컬 이미지 사용 시 비워둠

# 5. (선택) Node-RED 편집기 Ingress
NODERED_DOMAIN=                       # 예: ivr.nexuscommunity.kr (비우면 Ingress 생략)
