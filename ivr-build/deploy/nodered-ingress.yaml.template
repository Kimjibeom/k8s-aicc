# (선택) Node-RED 시나리오 편집기 외부 노출 — deploy.sh 가 NODERED_DOMAIN 지정 시 렌더링/적용
# 온프레미스 기준 Traefik IngressClass. 편집기는 admin 로그인(adminAuth) 보호 — 운영은 Secret 으로 비밀번호 교체 필수
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: aicc-${GROUP}-ivr-nodered
  namespace: ${NS}
  labels:
    aicc/service: ivr
    aicc/group: ${GROUP}
spec:
  ingressClassName: traefik
  rules:
  - host: ${NODERED_DOMAIN}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: aicc-${GROUP}-ivr
            port: { number: 1890 }
